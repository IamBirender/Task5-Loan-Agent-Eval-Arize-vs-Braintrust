# Copy this file to .env (same folder) and fill in your own keys. Never commit or share .env.
# Do not put spaces around "=".

# Documented path: four AgentCore specialists + Strands supervisor on the eval box.
# Offline debug only: MODEL_PROVIDER=local (DuckDB; does not feed the comparison)
# Wiring check: MODEL_PROVIDER=dryrun (no model is called)
MODEL_PROVIDER=agentcore
JUDGE_PROVIDER=bedrock
AWS_REGION=us-east-1
# Leave AWS keys empty on EC2 so boto3 uses the instance role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Arize AX (step 4) - app.arize.com -> Space settings -> API keys
ARIZE_SPACE_ID=
ARIZE_API_KEY=

# Braintrust (step 5) - braintrust.dev -> Settings -> API keys
BRAINTRUST_API_KEY=

# Optional local-only providers
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
GROQ_API_KEY=
