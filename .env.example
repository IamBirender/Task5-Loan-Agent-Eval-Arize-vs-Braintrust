# Copy this file to .env (same folder) and fill in your own keys. Never commit or share .env.
# Do not put spaces around "=".

# Documented path: Strands supervisor on this EC2 + four AgentCore specialists.
# Specialists run as AgentCore apps in this process (no Runtime ARN) unless you
# set LOAN_AGENTCORE_INVOKE=runtime after deploying LoanAgentStack.
# Offline debug only: MODEL_PROVIDER=local (DuckDB; does not feed the comparison)
# Wiring check: MODEL_PROVIDER=dryrun (no model is called)
MODEL_PROVIDER=agentcore
LOAN_AGENTCORE_INVOKE=local
JUDGE_PROVIDER=bedrock
AWS_REGION=us-east-1
# Leave AWS keys empty on EC2 so boto3 uses the instance role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Arize AX (step 4) - app.arize.com -> Space settings -> API keys
ARIZE_SPACE_ID=
ARIZE_API_KEY=

# Braintrust (step 5) - braintrust.dev -> Settings -> API keys
BRAINTRUST_API_KEY=

# Optional Track B (console or CDK). Leave blank to use DuckDB on this host.
# See docs/aws-services.md for how to create each resource.
# LOAN_RUNTIME_POOL_SCREENING_ARN=
# LOAN_RUNTIME_CREDIT_PERFORMANCE_ARN=
# LOAN_RUNTIME_COHORT_COMPARISON_ARN=
# LOAN_RUNTIME_COMPLIANCE_VALIDATION_ARN=
# LOAN_MEMORY_ID=
# LOAN_KB_ID=
# LOAN_DOCS_BUCKET=
# LOAN_AURORA_CLUSTER_ARN=
# LOAN_AURORA_SECRET_ARN=
# LOAN_GATEWAY_ARN=
# LOAN_GATEWAY_URL=
# LOAN_GUARDRAIL_ID=
# LOAN_GUARDRAIL_VERSION=DRAFT

# Optional local-only providers
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
GROQ_API_KEY=
